# Server Port (3000 is required by the cloud environment)
PORT=3000

# MySQL Database Configuration (Optional: fallback embedded SQL engine is used if MySQL is not running)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=ai_expense_manager

# JWT Authentication Secret
JWT_SECRET=your_jwt_secret_key_change_in_production_ai_expense

# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
